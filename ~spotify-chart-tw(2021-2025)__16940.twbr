      <column caption='大調和小調' datatype='string' name='[Calculation_0216121760907264]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [mode]=1 THEN &quot;大調&quot;&#13;&#10;elseif [mode]=0 THEN &quot;小調&quot;&#13;&#10;END' />
      </column>
      <column caption='調性' datatype='string' name='[Calculation_0216121763897346]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [key]=0 THEN &quot;C&quot;&#13;&#10;ELSEIF [key]=1 THEN &quot;C#&quot;&#13;&#10;ELSEIF [key]=2 THEN &quot;D&quot;&#13;&#10;ELSEIF [key]=3 THEN &quot;Eb&quot;&#13;&#10;ELSEIF [key]=4 THEN &quot;E&quot;&#13;&#10;ELSEIF [key]=5 THEN &quot;F&quot;&#13;&#10;ELSEIF [key]=6 THEN &quot;F#&quot;&#13;&#10;ELSEIF [key]=7 THEN &quot;G&quot;&#13;&#10;ELSEIF [key]=8 THEN &quot;Ab&quot;&#13;&#10;ELSEIF [key]=9 THEN &quot;A&quot;&#13;&#10;ELSEIF [key]=10 THEN &quot;Bb&quot;&#13;&#10;ELSEIF [key]=11 THEN &quot;B&quot;&#13;&#10;END' />
      </column>
      <column caption='依照年度的total_stream' datatype='real' name='[Calculation_0216121766031363]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED year([date]):SUM([total_stream])}' />
      </column>
      <column caption='年度歌曲數' datatype='integer' name='[Calculation_0216121767833605]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED YEAR([date]):COUNTD([id (year_chart)])}' />
      </column>
      <column caption='stream/樂曲量' datatype='real' name='[Calculation_0216121768595463]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([total_stream])/COUNTD([id (year_chart)])' />
      </column>
      <column caption='MS-&gt;Min.' datatype='real' name='[Calculation_0216121773391881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[duration_ms]/1000/60' />
      </column>
      <column caption='VE四象限' datatype='string' name='[Calculation_0216121775050762]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [energy]&gt;=0.5 AND [valence]&gt;=0.5 THEN &quot;高能量正向情緒&quot;&#13;&#10;ELSEIF [energy]&lt;=0.5 AND [valence]&gt;=0.5 THEN &quot;低能量正向情緒&quot;&#13;&#10;ELSEIF [energy]&lt;=0.5 AND [valence]&lt;=0.5 THEN &quot;低能量負向情緒&quot;&#13;&#10;ELSEIF [energy]&gt;=0.5 AND [valence]&lt;=0.5 THEN &quot;高能量負向情緒&quot;&#13;&#10;END' />
      </column>
      <column caption='大面積的發行年代' datatype='boolean' name='[Calculation_0216121779253259]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK(COUNTD([release_date]))&lt;=5'>
