            <column caption='VE四象限' datatype='string' name='[Calculation_0216121775050762]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [energy]&gt;=0.5 AND [valence]&gt;=0.5 THEN &quot;高能量正向情緒&quot;&#13;&#10;ELSEIF [energy]&lt;=0.5 AND [valence]&gt;=0.5 THEN &quot;低能量正向情緒&quot;&#13;&#10;ELSEIF [energy]&lt;=0.5 AND [valence]&lt;=0.5 THEN &quot;低能量負向情緒&quot;&#13;&#10;ELSEIF [energy]&gt;=0.5 AND [valence]&lt;=0.5 THEN &quot;高能量負向情緒&quot;&#13;&#10;END' />
            </column>
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Energy' datatype='real' name='[energy]' role='measure' type='quantitative' />
            <column caption='Isrc (Song Features)' datatype='string' name='[isrc (song_features)]' role='dimension' type='nominal' />
