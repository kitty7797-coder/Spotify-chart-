    <worksheet name='Valence &amp; Energy'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Valence &amp; Energy</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='song+ (spotify)' name='federated.1r7iwnw01pyzdg10m2hbh1jyn9np' />
